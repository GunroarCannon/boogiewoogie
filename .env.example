# Secret pepper used to salt & hash list keys before storing pointer baskets.
KEY_PEPPER=change-this-to-a-random-secret-string

# Pantry ID from https://getpantry.cloud/
# Optional: leave empty for local development storage
PANTRY_ID=

# Groq API Key from https://console.groq.com/
# Optional: leave empty to use built-in browser speech recognition
GROQ_API_KEY=
